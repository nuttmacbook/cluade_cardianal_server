# ---- on the chain machine (crontab -e as user cardianal)
# backup every 6 h, keep 8 sets, then ship off the machine (configure the rclone remote yourself) · single machine = backups are the only way to recover
0 */6 * * *  cd /opt/cardianal && node scripts/backup.js --data /var/lib/cardianal --out /backups --keep 8 && rclone sync /backups remote:cardianal-backups

# ---- on another machine (a dead chain machine can't alert about itself)
* * * * *  cd ~/cardianal && node scripts/monitor.js --url https://chain.example.com --once >/dev/null || curl -s -d "Bluewolfchain: /health reports problems" https://hooks.example.com/<webhook>

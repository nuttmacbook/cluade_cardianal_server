# เครื่องสำรอง (ไม่ผลิต block · ซิงก์ตามเครื่องผู้ผลิต) · copy เป็น deploy/follower.env แล้ว
#   node --env-file=deploy/follower.env server.js
GENESIS=deploy/genesis.mainnet.json
DATA=/var/lib/cardianal
HOST=127.0.0.1
PORT=3000
FOLLOW=https://<โดเมนเครื่องผู้ผลิต>
TRUST_PROXY=1
EVM_NAME=Cardianal
EVM_SYMBOL=CARD
# FOLLOW_SNAPSHOT=1       DB ว่าง: เริ่มจาก snapshot ของเครื่องผู้ผลิตแทนซิงก์ตั้งแต่ block 1

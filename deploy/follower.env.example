# standby machine (doesn't produce blocks · syncs from the producer) · copy to deploy/follower.env, then
#   node --env-file=deploy/follower.env server.js
GENESIS=deploy/genesis.mainnet.json
DATA=/var/lib/cardianal
HOST=127.0.0.1
PORT=3000
FOLLOW=https://<producer domain>
TRUST_PROXY=1
EVM_NAME=Bluewolfchain
EVM_SYMBOL=BWSC
# FOLLOW_SNAPSHOT=1       empty DB: start from the producer's snapshot instead of syncing from block 1

# เครื่องผู้ผลิต · copy เป็น deploy/producer.env (chmod 600 · อยู่ใน .gitignore) แล้ว
#   node --env-file=deploy/producer.env scripts/preflight.js     # ตรวจก่อน
#   node --env-file=deploy/producer.env server.js
# ค่าของเชน (chainId, admins, producers, block, แก๊ส) อยู่ใน genesis ไม่ต้องใส่ที่นี่ (ใส่แล้วไม่ตรง = server ไม่ยอมเริ่ม)
GENESIS=deploy/genesis.mainnet.json
DATA=/var/lib/cardianal
HOST=127.0.0.1
PORT=3000
PRODUCER_KEY=0x<key ผู้ผลิตหลัก>
TRUST_PROXY=1
SNAPSHOT_EVERY=3600
EVM_NAME=Cardianal
EVM_SYMBOL=CARD
# RATE_LIMIT=120          POST /sendtx, /query ต่อ IP ต่อนาที
# EVM_RATE_LIMIT=600      /evm ต่อ IP ต่อนาที (0 = ไม่จำกัด ใช้ตอนต่อ Blockscout ในเครื่อง)
# HISTORY_KEEP_BLOCKS=    ไม่ตั้ง = เก็บทั้งหมด

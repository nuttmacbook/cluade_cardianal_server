# producer machine · copy to deploy/producer.env (chmod 600 · listed in .gitignore), then
#   node --env-file=deploy/producer.env scripts/preflight.js     # check first
#   node --env-file=deploy/producer.env server.js
# chain values (chainId, admins, producers, block, gas) live in genesis, don't set them here (setting a mismatching value = the server refuses to start)
GENESIS=deploy/genesis.mainnet.json
DATA=/var/lib/cardianal
HOST=127.0.0.1
PORT=3000
PRODUCER_KEY=0x<primary producer key>
TRUST_PROXY=1
SNAPSHOT_EVERY=3600
EVM_NAME=Bluewolfchain
EVM_SYMBOL=BWSC
# RATE_LIMIT=120          POST /sendtx, /query per IP per minute
# EVM_RATE_LIMIT=600      /evm per IP per minute (0 = unlimited, for a local Blockscout)
# EVM_MAX_BATCH=1000      max requests per /evm batch (each item in a batch counts toward EVM_RATE_LIMIT)
# MAX_BODY_BYTES=1048576  max POST body · exceeded = 413
# HISTORY_KEEP_BLOCKS=    unset = keep everything

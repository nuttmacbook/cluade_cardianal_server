# /etc/systemd/system/cardianal.service
#   sudo systemctl enable --now cardianal · view logs: journalctl -u cardianal -f
# a single producer machine can auto-restart · with a standby, never let the standby become a producer by itself (switch manually via FAILOVER_FROM)
[Unit]
Description=Bluewolfchain
After=network-online.target
Wants=network-online.target

[Service]
User=cardianal
WorkingDirectory=/opt/cardianal
ExecStartPre=/usr/bin/node --env-file=/opt/cardianal/deploy/producer.env scripts/preflight.js
ExecStart=/usr/bin/node --env-file=/opt/cardianal/deploy/producer.env server.js
Restart=always
RestartSec=3
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
